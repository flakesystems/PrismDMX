{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "eslint/no-console": "error"
  },
  "overrides": [
    {
      "files": [
        "src/core/log/logger.ts"
      ],
      "rules": {
        "eslint/no-console": "off"
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "e2e/**",
        "src/core/testing/**",
        "scripts/**"
      ],
      "rules": {
        "eslint/no-console": "off"
      }
    }
  ],
  "ignorePatterns": [
    "legacy/**",
    "src/bindings/**"
  ]
}

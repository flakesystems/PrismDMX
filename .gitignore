# Rust
/target/
**/*.rs.bk
*.pdb

# `tools/xtouch-probe` is deliberately not a workspace member (it opens a MIDI
# port, which ARCHITECTURE_SPEC.md 10.1 allows prism-surface no part of), so it
# has a build directory of its own that the root /target/ rule does not cover.
# Its Cargo.lock *is* committed: it is a binary, and a bring-up tool that builds
# differently next year is a measurement nobody can reproduce.
tools/*/target/

# Node / UI
node_modules/
ui/dist/
ui/.vite/
*.tsbuildinfo

# Tauri
crates/prism-app/gen/
crates/prism-app/target/

# Generated bindings (regenerated from prism-domain)
ui/src/bindings/

# Show files and runtime data
*.prism
*.prism-shm
*.prism-wal
*.prism.backup
/recovery/

# ...except the frozen file S15's migration test reads. It is a version-1
# `.prism` file, written once and never again: a migration checked against a
# file the current code has just produced is a migration checked against itself.
!crates/prism-core/tests/fixtures/*.prism

# Coverage and profiling
/coverage/
*.profraw
tarpaulin-report.*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Playwright
ui/test-results/
ui/playwright-report/
ui/coverage/
ui/blob-report/
ui/.playwright/
